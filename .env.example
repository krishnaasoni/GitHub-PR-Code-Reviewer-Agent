# ==============================================================================
# Telegram GitHub PR & Code Reviewer Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Settings (Required)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use: "gemini-1.5-flash" (fast, lightweight, cost-efficient) or "gemini-1.5-pro"
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Telegram Bot Configuration (Required for Telegram Integration)
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram (https://t.me/BotFather) and copy token:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# ------------------------------------------------------------------------------
# 3. GitHub API Configuration (Optional - Recommended for Private Repos & High Limits)
# ------------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained) with 'repo' read scope:
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 4. Switch AI Gateway Settings
# ------------------------------------------------------------------------------
# Target webhook where Switch routes incoming Telegram messages:
SWITCH_AGENT_WEBHOOK_URL=http://reviewer-agent:8000/webhook
SWITCH_GATEWAY_PORT=3000

# ------------------------------------------------------------------------------
# 5. Service Tuning
# ------------------------------------------------------------------------------
PORT=8000
MAX_DIFF_CHARS=40000

